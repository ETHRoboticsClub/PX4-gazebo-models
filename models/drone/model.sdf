<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="drone">
    <self_collide>false</self_collide>
    <static>false</static>
    <!-- ===================================================== -->
    <!--                    BASE LINK                         -->
    <!-- ===================================================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>1.3116</mass>
        <inertia>
          <ixx>0.003708</ixx>
          <iyy>0.002511</iyy>
          <izz>0.004013</izz>
          <ixy>0</ixy>
          <ixz>-2e-06</ixz>
          <iyz>-1.7e-05</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://drone/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_collision">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://drone/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <!-- ===================== SENSORS ===================== -->

      <!-- IMU -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00084</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00084</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00084</stddev>
              </noise>
            </z>
          </angular_velocity>

          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- MAGNETOMETER -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian"><stddev>0.0001</stddev></noise>
          </x>
          <y>
            <noise type="gaussian"><stddev>0.0001</stddev></noise>
          </y>
          <z>
            <noise type="gaussian"><stddev>0.0001</stddev></noise>
          </z>
        </magnetometer>
      </sensor>

      <!-- BAROMETER -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>1.3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- GPS -->
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <!-- <navsat>
          <position>
            <x><noise type="gaussian"><stddev>0.7</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.7</stddev></noise></y>
            <z><noise type="gaussian"><stddev>1.0</stddev></noise></z>
          </position>
          <velocity>
            <x><noise type="gaussian"><stddev>0.1</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.1</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.1</stddev></noise></z>
          </velocity>
        </navsat> -->
      </sensor>

      <!-- CAMERA -->
      <sensor name="front_camera" type="camera">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <pose>0.05 0.0 0.03 0 0 0</pose>
        <camera>
          <horizontal_fov>2.705</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>100</far>
          </clip>
          <lens>
            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>
          </lens>
        </camera>
        <topic>/drone/camera/image_raw</topic>
      </sensor>


    </link>

    <!-- ===================== ROTORS ===================== -->

    <link name="rotor_0">
      <pose>0.09 -0.09 0.02 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    </link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_1">
      <pose>-0.09 0.09 0.02 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    </link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_2">
      <pose>0.09 0.09 0.02 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    </link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_3">
      <pose>-0.09 -0.09 0.02 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    </link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz></axis></joint>

    <!-- ===================== MOTOR MODELS ===================== -->

    <!-- MOTOR 0 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <motorNumber>0</motorNumber>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2000</maxRotVelocity>
      <timeConstantUp>0.005</timeConstantUp>
      <timeConstantDown>0.010</timeConstantDown>
      <motorConstant>1.4e-5</motorConstant>
      <momentConstant>0.05</momentConstant>
      <rotorDragCoefficient>1e-4</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <!-- MOTOR 1 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <motorNumber>1</motorNumber>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2000</maxRotVelocity>
      <timeConstantUp>0.005</timeConstantUp>
      <timeConstantDown>0.010</timeConstantDown>
      <motorConstant>1.4e-5</motorConstant>
      <momentConstant>0.05</momentConstant>
      <rotorDragCoefficient>1e-4</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <!-- MOTOR 2 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <motorNumber>2</motorNumber>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2000</maxRotVelocity>
      <timeConstantUp>0.005</timeConstantUp>
      <timeConstantDown>0.010</timeConstantDown>
      <motorConstant>1.4e-5</motorConstant>
      <momentConstant>0.05</momentConstant>
      <rotorDragCoefficient>1e-4</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <!-- MOTOR 3 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <motorNumber>3</motorNumber>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2000</maxRotVelocity>
      <timeConstantUp>0.005</timeConstantUp>
      <timeConstantDown>0.010</timeConstantDown>
      <motorConstant>1.4e-5</motorConstant>
      <momentConstant>0.05</momentConstant>
      <rotorDragCoefficient>1e-4</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

  </model>
</sdf>
